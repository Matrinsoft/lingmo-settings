[Desktop Entry]
Name=Window management
Comment=Super key action, window control options, and additional window tiling options.
Type=Application
Exec=lingmo-settings window-management
Terminal=false
Categories=Lingmo
Keywords=COSMIC;Window;Management;Tiling;Super;Key;
NoDisplay=true
